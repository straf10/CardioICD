# Secrets (do not commit)
.env

# Local working material
report/raw_data/

# Cursor IDE personal config
.cursorrules

# Python virtual environment
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Setuptools / pip (editable install metadata, wheels, sdist)
*.egg-info/
dist/
build/
*.egg

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Run artifacts: models, predictions and reports are regenerated by the pipeline
outputs/
report/figures/_metrics_audit.json
report/figures/*.pdf
report/main.pdf

# Deprecated path (old runs); training/inference now write under outputs/models/<method>/
outputs/experiments/
outputs/predictions/

# NER: duplicate or named model exports (use outputs/models/ner_el/ locally, not a second copy in git)
outputs/models/NER_EL_day1_verify/

# Trained model weights, checkpoints, and training state under outputs/ (ship via artifact, scp, or LFS)
outputs/**/*.safetensors
outputs/**/*.npy
!outputs/**/ensemble_val_scores.npy
outputs/**/*.pt
outputs/**/*.pth
# Demo export caches (the IR index is built from training text, i.e. real patient data)
outputs/models/ir_app_cache/
outputs/models/ct2_opus_en_el/
# Old Streamlit showcase cache (real patient text): keep any local copy out of git
app/artifacts/showcase.json
outputs/**/optimizer.pt
outputs/**/rng_state.pth
outputs/**/scheduler.pt
outputs/**/training_args.bin
outputs/**/trainer_state.json
outputs/**/checkpoint-*/
# Run dumps that landed under a model dir
outputs/**/predictions.jsonl
outputs/**/test_predictions.jsonl
outputs/**/predictions_*.jsonl
outputs/**/*_debug.jsonl
outputs/**/*.log
# Ad-hoc analysis / val tracking files (kept locally when produced)
outputs/**/error_analysis.json
outputs/**/per_class_report.csv
outputs/**/run_analysis.md
outputs/**/val_patient_ids.json
outputs/**/val_pids.json
# XLM-R Large: version val calibration artifacts for evaluation config
!outputs/models/xlm_r_large/val_scores.npy
!outputs/models/xlm_r_large/val_patient_ids.json
outputs/**/cooccurrence_rules.json
outputs/**/*Final*Prediction*Results*
outputs/**/train_*_base*.log

# Trial run artifacts (local experiments, not needed in repo)
trial_runs/

# Local training logs under src (should not be committed)
src/xlm_r_base/train_v15_base.log

# Weights & Biases local run data (runs sync to wandb.ai; not needed in repo)
wandb/
data/processed/_augmented/

# Local comparison notes (optional; remove from gitignore if you want to track it)
XLM_R_LARGE_VS_BASE.md

# Private dictionary refactor notes (local only)
MEMORY.md
BERT_MEMORY.md
Finetuning_Methodology_Report.md
Finetuning_Methodology_Report.pdf

# NER+EL debug variants contain raw clinical text fragments (mention_level_annotations) — never commit
outputs/**/*_predictions.debug.jsonl

# Raw / processed clinical text (real patient data — see data/DATA.md for schema & provenance)
data/raw/*.jsonl
data/processed/*.jsonl
!data/raw/split_report.json
!data/raw/labelset.txt

# Blind-test submission dumps: patient_id+codes only, but not reproducible without
# the non-public dataset, so kept local rather than committed
blind/*.jsonl

# LaTeX build artifacts
*.aux
*.fls
*.fdb_latexmk
*.xdv
*.xmpi
texput.log
*.log
*.abs
*.xmpdata

# Internal peer-review notes on the paper draft (local only, not for public repo)
report/review.md

# LaTeX source kept local; the published paper is linked from the README
report/main.tex
report/body.tex
report/ceurart.cls
report/sections/

# Submission logistics archives (not needed to run or reproduce the code)
ElCardioCC_CEUR_source.zip
blind/aida-uom-team.zip

# Local audit notes (kept locally only, not part of the public repo)
audits/

# Source media and build scripts for assets/pipeline.gif (kept locally; only the
# rendered GIF is versioned — the sources are ~18 MB of stills and raw footage)
assets/keyframes/
assets/pipeline.mp4
